# .env file - Store sensitive environment variables here
# This file should NOT be committed to version control (e.g., Git)!

# Django Secret Key (VERY IMPORTANT - GENERATE A NEW ONE FOR PRODUCTION!)
# You can generate one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY='your_super_secret_django_key_here'

# Email Configuration
# Choose your email backend:
# 'django.core.mail.backends.smtp.EmailBackend' (for real sending)
# 'django.core.mail.backends.console.EmailBackend' (for printing emails to console)
# 'django.core.mail.backends.filebased.EmailBackend' (for saving emails to a file)
EMAIL_BACKEND='django.core.mail.backends.smtp.EmailBackend'

# SMTP Server Host (e.g., for Gmail: smtp.gmail.com, for SendGrid: smtp.sendgrid.net)
EMAIL_HOST='smtp.your_email_provider.com'

# SMTP Server Port (e.g., 587 for TLS, 465 for SSL)
EMAIL_PORT='your_email_port_here'  # e.g., 587 for TLS, 465 for SSL

# Use TLS (True/False) - often required for port 587
EMAIL_USE_TLS=True / False

# Your email address for sending emails
EMAIL_HOST_USER='your_sending_email@example.com'

# Your email password or app-specific password (NEVER your main account password!)
# For Gmail, you'll need to generate an App Password if 2FA is enabled.
EMAIL_HOST_PASSWORD='your_email_app_password'

# The 'From' email address that appears in sent emails
DEFAULT_FROM_EMAIL='noreply@yourdomain.com'

# The email address for error reporting (can be the same as DEFAULT_FROM_EMAIL)
SERVER_EMAIL='admin@yourdomain.com'

# Optional: Set DEBUG and ALLOWED_HOSTS for production
# DEBUG=False
# ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
