        if path:
            self.output_dir.set(path)
            
    def pick_color(self):
        color = colorchooser.askcolor(title="Select background color to remove",
                                     initialcolor=self.bg_color.get())
        if color[1]:
            self.bg_color.set(color[1])
            self.color_preview.configure(bg=color[1])
            self.update_logo_preview()
            
    def update_logo_preview(self):
        logo_path = self.logo_path.get()
        if not logo_path or not os.path.exists(logo_path):
            self.preview_label.configure(image='', text="Select a valid logo file")
            return
            
        try:
            # Load and process logo
            img = Image.open(logo_path).convert("RGBA")
            
            # Remove background color
            bg_color = self.hex_to_rgb(self.bg_color.get())
            data = np.array(img)
            r, g, b, a = data.T
            
            # Create mask for background pixels (with tolerance)
            tolerance = self.tolerance.get()
            background_pixels = (
                (np.abs(r - bg_color[0]) < tolerance) & 
                (np.abs(g - bg_color[1]) < tolerance) & 
                (np.abs(b - bg_color[2]) < tolerance)
            )
            data[..., 3][background_pixels.T] = 0  # Set alpha to 0
            
            processed_logo = Image.fromarray(data)
            
            # Apply opacity
            if self.logo_opacity.get() < 100:
                alpha = processed_logo.split()[-1]
                alpha = alpha.point(lambda x: int(x * (self.logo_opacity.get() / 100.0)))
                processed_logo.putalpha(alpha)
            
            # Resize for preview (maintain aspect ratio)
            preview_size = (200, 200)
            processed_logo.thumbnail(preview_size, Image.Resampling.LANCZOS)
            
            # Convert to PhotoImage
            self.logo_preview = ImageTk.PhotoImage(processed_logo)
            self.preview_label.configure(image=self.logo_preview, text="")
            
        except Exception as e:
            self.preview_label.configure(image='', text=f"Error loading logo:\n{str(e)}")
            
    def validate_inputs(self):
        logo_path = self.logo_path.get()
        output_dir = self.output_dir.get()
        
        if not logo_path:
            messagebox.showerror("Error", "Please select a logo file")
            return False
            
        if not os.path.exists(logo_path):
            messagebox.showerror("Error", "Logo file does not exist")
            return False
            
        if not self.input_paths:
            messagebox.showerror("Error", "Please select input files or folders")
            return False
            
        if not output_dir:
            messagebox.showerror("Error", "Please select an output directory")
            return False
            
        # Create output directory if it doesn't exist
        os.makedirs(output_dir, exist_ok=True)
        
        return True
        
    def start_processing(self):
        if not self.validate_inputs():
            return
            
        if self.processing:
            messagebox.showwarning("Warning", "Processing already in progress")
            return
            
        # Start processing in a separate thread
        self.processing = True
        self.process_btn.configure(text="Processing...", state='disabled')
        self.progress.configure(mode='determinate', value=0)
        
        processing_thread = threading.Thread(target=self.process_files)
        processing_thread.daemon = True
        processing_thread.start()
        
    def process_files(self):
        try:
            logo_path = self.logo_path.get()
            output_dir = self.output_dir.get()
            
            # Update status
            self.root.after(0, lambda: self.status_label.configure(text="Processing logo..."))
            
            # Process logo
            logo = self.process_logo(logo_path)
            
            # Collect all files to process
            files_to_process = []
            
            for input_path in self.input_paths:
                if os.path.isfile(input_path):
                    if self.is_media_file(input_path):
                        files_to_process.append(input_path)
                else:
                    # Process folder
                    for filename in os.listdir(input_path):
                        filepath = os.path.join(input_path, filename)
                        if os.path.isfile(filepath) and self.is_media_file(filename):
                            files_to_process.append(filepath)
            
            total_files = len(files_to_process)
            processed_files = 0
            
            # Process each file
            for i, input_file in enumerate(files_to_process):
                filename = os.path.basename(input_file)
                self.root.after(0, lambda f=filename: 
                              self.status_label.configure(text=f"Processing: {f}"))
                
                # Generate output filename
                name, ext = os.path.splitext(filename)
                if self.batch_rename.get():
                    output_filename = f"{self.prefix.get()}{name}{ext}"
                else:
                    output_filename = filename
                    
                output_path = os.path.join(output_dir, output_filename)
                
                # Process based on file type
                if filename.lower().endswith(('.png', '.jpg', '.jpeg', '.bmp', '.gif', '.webp')):
                    self.process_image(input_file, output_path, logo)
                elif filename.lower().endswith(('.mp4', '.avi', '.mov', '.mkv')):
                    self.process_video(input_file, output_path, logo)
                
                processed_files += 1
                progress_value = (processed_files / total_files) * 100
                self.root.after(0, lambda p=progress_value: self.progress.configure(value=p))
                
            # Processing completed
            self.root.after(0, self.processing_completed)
            
        except Exception as e:
            self.root.after(0, lambda: self.processing_error(str(e)))
            
    def processing_completed(self):
        self.processing = False
        self.progress.configure(value=100)
        self.process_btn.configure(text="🎬 Start Processing", state='normal')
        self.status_label.configure(text="✅ Processing completed successfully!")
        messagebox.showinfo("Success", "All files have been processed successfully!")
        
    def processing_error(self, error_msg):
        self.processing = False
        self.progress.configure(value=0)
        self.process_btn.configure(text="🎬 Start Processing", state='normal')
        self.status_label.configure(text="❌ Processing failed")
        messagebox.showerror("Error", f"Processing failed:\n{error_msg}")
        
    def process_logo(self, logo_path):
        # Load and process logo
        img = Image.open(logo_path).convert("RGBA")
        bg_color = self.hex_to_rgb(self.bg_color.get())
        
        # Make background transparent with tolerance
        data = np.array(img)
        r, g, b, a = data.T
        
        tolerance = self.tolerance.get()
        background_pixels = (
            (np.abs(r - bg_color[0]) < tolerance) & 
            (np.abs(g - bg_color[1]) < tolerance) & 
            (np.abs(b - bg_color[2]) < tolerance)
        )
        data[..., 3][background_pixels.T] = 0  # Set alpha to 0
        
        processed_logo = Image.fromarray(data)
        
        # Apply opacity
        if self.logo_opacity.get() < 100:
            # Adjust alpha channel for opacity
            alpha = processed_logo.split()[-1]
            alpha = alpha.point(lambda x: int(x * (self.logo_opacity.get() / 100.0)))
            processed_logo.putalpha(alpha)
        
        return processed_logo
        
    def process_image(self, input_path, output_path, logo):
        try:
            img = Image.open(input_path).convert("RGBA")
            
            # Calculate logo size based on image width
            logo_size_ratio = self.logo_size.get() / 100.0
            new_width = int(img.width * logo_size_ratio)
            
            if self.maintain_aspect.get():
                # Maintain aspect ratio
                aspect_ratio = logo.height / logo.width
                new_height = int(new_width * aspect_ratio)
            else:
                new_height = int(img.height * logo_size_ratio)
                
            resized_logo = logo.resize((new_width, new_height), Image.Resampling.LANCZOS)
            
            # Calculate position
            x, y = self.calculate_position(img.width, img.height, 
                                         resized_logo.width, resized_logo.height)
            
            # Paste logo
            img.paste(resized_logo, (x, y), resized_logo)
            
            # Convert back to RGB if saving as JPEG
            if output_path.lower().endswith(('.jpg', '.jpeg')):
                img = img.convert("RGB")
                
            img.save(output_path, quality=95, optimize=True)
            
        except Exception as e:
            print(f"Error processing image {os.path.basename(input_path)}: {str(e)}")
            
    def process_video(self, input_path, output_path, logo):
        try:
            cap = cv2.VideoCapture(input_path)
            fps = cap.get(cv2.CAP_PROP_FPS)
            width = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))
            height = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))
            total_frames = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))
            
            fourcc = cv2.VideoWriter_fourcc(*'mp4v')
            out = cv2.VideoWriter(output_path, fourcc, fps, (width, height))
            
            # Calculate logo size based on video width
            logo_size_ratio = self.logo_size.get() / 100.0
            new_width = int(width * logo_size_ratio)
            
            if self.maintain_aspect.get():
                aspect_ratio = logo.height / logo.width
                new_height = int(new_width * aspect_ratio)
            else:
                new_height = int(height * logo_size_ratio)
                
            resized_logo = logo.resize((new_width, new_height), Image.Resampling.LANCZOS)
            frame_count = 0
            
            while cap.isOpened():
                ret, frame = cap.read()
                if not ret:
                    break
                    
                # Convert frame to PIL Image
                pil_frame = Image.fromarray(cv2.cvtColor(frame, cv2.COLOR_BGR2RGB))
                x, y = self.calculate_position(width, height, 
                                             resized_logo.width, resized_logo.height)
                pil_frame.paste(resized_logo, (x, y), resized_logo)
                
                # Convert back to OpenCV format
                frame = cv2.cvtColor(np.array(pil_frame), cv2.COLOR_RGB2BGR)
                out.write(frame)
                
                frame_count += 1
                if frame_count % 30 == 0:  # Update every 30 frames
                    progress = (frame_count / total_frames) * 100
                    filename = os.path.basename(input_path)
                    self.root.after(0, lambda f=filename, p=progress: 
                                  self.status_label.configure(text=f"Processing video: {f} ({p:.1f}%)"))
                
            cap.release()
            out.release()
            
        except Exception as e:
            print(f"Error processing video {os.path.basename(input_path)}: {str(e)}")
            
    def calculate_position(self, img_w, img_h, logo_w, logo_h):
        pos = self.position.get()
        margin_x = self.margin_x.get()
        margin_y = self.margin_y.get()
        
        positions = {
            "top-left": (margin_x, margin_y),
            "top-center": ((img_w - logo_w) // 2, margin_y),
            "top-right": (img_w - logo_w - margin_x, margin_y),
            "center-left": (margin_x, (img_h - logo_h) // 2),
            "center": ((img_w - logo_w) // 2, (img_h - logo_h) // 2),
            "center-right": (img_w - logo_w - margin_x, (img_h - logo_h) // 2),
            "bottom-left": (margin_x, img_h - logo_h - margin_y),
            "bottom-center": ((img_w - logo_w) // 2, img_h - logo_h - margin_y),
            "bottom-right": (img_w - logo_w - margin_x, img_h - logo_h - margin_y)
        }
        
        return positions.get(pos, positions["bottom-right"])
            
    def hex_to_rgb(self, hex_color):
        hex_color = hex_color.lstrip('#')
        return tuple(int(hex_color[i:i+2], 16) for i in (0, 2, 4))
        
    def save_settings(self):
        settings = {
            'position': self.position.get(),
            'bg_color': self.bg_color.get(),
            'logo_opacity': self.logo_opacity.get(),
            'logo_size': self.logo_size.get(),
            'margin_x': self.margin_x.get(),
            'margin_y': self.margin_y.get(),
            'tolerance': self.tolerance.get(),
            'maintain_aspect': self.maintain_aspect.get(),
            'batch_rename': self.batch_rename.get(),
            'prefix': self.prefix.get()
        }
        
        try:
            with open(self.settings_file, 'w') as f:
                json.dump(settings, f, indent=4)
            messagebox.showinfo("Success", "Settings saved successfully!")
        except Exception as e:
            messagebox.showerror("Error", f"Could not save settings: {str(e)}")
            
    def load_settings(self):
        try:
            if os.path.exists(self.settings_file):
                with open(self.settings_file, 'r') as f:
                    settings = json.load(f)
                    
                # Apply settings
                self.position.set(settings.get('position', 'bottom-right'))
                self.bg_color.set(settings.get('bg_color', '#FFFFFF'))
                self.logo_opacity.set(settings.get('logo_opacity', 100))
                self.logo_size.set(settings.get('logo_size', 15))
                self.margin_x.set(settings.get('margin_x', 20))
                self.margin_y.set(settings.get('margin_y', 20))
                self.tolerance.set(settings.get('tolerance', 30))
                self.maintain_aspect.set(settings.get('maintain_aspect', True))
                self.batch_rename.set(settings.get('batch_rename', False))
                self.prefix.set(settings.get('prefix', 'watermarked_'))
                
                # Update color preview
                self.color_preview.configure(bg=self.bg_color.get())
                
        except Exception as e:
            print(f"Could not load settings: {str(e)}")

