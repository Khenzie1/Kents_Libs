    # File selection methods (Enhanced)
    def browse_logo(self):
        path = filedialog.askopenfilename(
            title="Select Logo File",
            filetypes=[("Image Files", "*.png *.jpg *.jpeg *.gif *.bmp *.webp")]
        )
        if path:
            self.logo_path.set(path)
            self.update_logo_preview()
            
    def add_folder(self):
        path = filedialog.askdirectory(title="Select Input Folder")
        if path and path not in self.input_paths:
            self.input_paths.append(path)
            self.update_input_display()
            
    def add_files(self):
        paths = filedialog.askopenfilenames(
            title="Select Input Files",
            filetypes=[
                ("All Media", "*.png *.jpg *.jpeg *.gif *.bmp *.webp *.mp4 *.avi *.mov *.mkv"),
                ("Image Files", "*.png *.jpg *.jpeg *.gif *.bmp *.webp"),
                ("Video Files", "*.mp4 *.avi *.mov *.mkv")
            ]
        )
        for path in paths:
            if path not in self.input_paths:
                self.input_paths.append(path)
        self.update_input_display()
        
    def clear_inputs(self):
        self.input_paths.clear()
        self.update_input_display()
        
    def update_input_display(self):
        if not self.input_paths:
            self.input_display.set("No files/folders selected")
            self.file_count_label.configure(text="")
        else:
            display_text = "Selected:\n"
            file_count = 0
            
            for i, path in enumerate(self.input_paths):
                if i < 3:  # Show first 3 items
                    display_text += f"• {os.path.basename(path)}\n"
                elif i == 3:
                    display_text += f"... and {len(self.input_paths) - 3} more items"
                    
                # Count files
                if os.path.isfile(path):
                    file_count += 1
                else:
                    # Count files in folder
                    for filename in os.listdir(path):
                        filepath = os.path.join(path, filename)
                        if os.path.isfile(filepath) and self.is_media_file(filename):
                            file_count += 1
            
            self.input_display.set(display_text.strip())
            self.file_count_label.configure(text=f"Estimated files to process: {file_count}")
            
    def is_media_file(self, filename):
        return filename.lower().endswith(('.png', '.jpg', '.jpeg', '.bmp', '.gif', '.webp',
                                         '.mp4', '.avi', '.mov', '.mkv'))
        
    def browse_output(self):
