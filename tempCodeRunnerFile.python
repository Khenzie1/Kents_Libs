        ttk.Label(recurring_frame, text="Frequency:").pack(side='left', padx=(20,5))
        frequency_combo = ttk.Combobox(recurring_frame, textvariable=self.frequency_var, width=15)
        frequency_combo['values'] = ('Daily', 'Weekly', 'Monthly')
        frequency_combo.pack(side='left', padx=5)
        
        # Schedule button
        ttk.Button(schedule_frame, text="📅 Schedule Message", 
                     command=self.schedule_group_message, style='Custom.TButton').pack(pady=10)
    
    def create_logs_tab(self):
        """Create the logs and analytics tab"""
