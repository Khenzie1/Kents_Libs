        self.notebook.add(logs_frame, text="📊 Logs & Analytics")
        
        # Statistics overview
        stats_frame = ttk.LabelFrame(logs_frame, text="Engagement Statistics", padding=10)
        stats_frame.pack(fill='x', padx=10, pady=5)
        
        stats_grid = ttk.Frame(stats_frame)
        stats_grid.pack()
        
        # Stats labels
        self.total_contacts_label = ttk.Label(stats_grid, text="Total Contacts: 0", font=('Arial', 12, 'bold'))
        self.total_contacts_label.grid(row=0, column=0, padx=20, pady=5)
        
        self.messages_sent_label = ttk.Label(stats_grid, text="Messages Sent Today: 0", font=('Arial', 12, 'bold'))
        self.messages_sent_label.grid(row=0, column=1, padx=20, pady=5)
        
        self.scheduled_messages_label = ttk.Label(stats_grid, text="Scheduled Messages: 0", font=('Arial', 12, 'bold'))
        self.scheduled_messages_label.grid(row=0, column=2, padx=20, pady=5)
        
        # Message log
        log_frame = ttk.LabelFrame(logs_frame, text="Message Log", padding=10)
        log_frame.pack(fill='both', expand=True, padx=10, pady=5)
        
        # Log treeview
        log_columns = ('Timestamp', 'Type', 'Recipient', 'Message Preview', 'Status')
        self.log_tree = ttk.Treeview(log_frame, columns=log_columns, show='headings', height=15)
        
        for col in log_columns:
            self.log_tree.heading(col, text=col)
            self.log_tree.column(col, width=150)
        
        log_scrollbar = ttk.Scrollbar(log_frame, orient='vertical', command=self.log_tree.yview)
        self.log_tree.configure(yscrollcommand=log_scrollbar.set)
        
        self.log_tree.pack(side='left', fill='both', expand=True)
        log_scrollbar.pack(side='right', fill='y')
        
        # Export options
        export_frame = ttk.Frame(log_frame)
        export_frame.pack(side='bottom', fill='x', pady=10)
        
        ttk.Button(export_frame, text="📄 Export Log to CSV", 
                     command=self.export_log).pack(side='left', padx=5)
        ttk.Button(export_frame, text="🗑️ Clear Log", 
                     command=self.clear_log).pack(side='left', padx=5)
    
    def create_settings_tab(self):
        """Create the settings tab"""
        settings_frame = ttk.Frame(self.notebook)
        self.notebook.add(settings_frame, text="⚙️ Settings")
        
        # WhatsApp Web settings
        whatsapp_frame = ttk.LabelFrame(settings_frame, text="WhatsApp Web Settings", padding=10)
        whatsapp_frame.pack(fill='x', padx=10, pady=5)
        
        ttk.Label(whatsapp_frame, text="Browser:").pack(anchor='w')
        browser_combo = ttk.Combobox(whatsapp_frame, textvariable=self.browser_var)
        browser_combo['values'] = ('Chrome', 'Firefox', 'Edge')
        browser_combo.pack(pady=5, fill='x')
        
        ttk.Label(whatsapp_frame, text="Wait time for page load (seconds):").pack(anchor='w', pady=(10,0))
        ttk.Spinbox(whatsapp_frame, from_=5, to=30, textvariable=self.wait_time_var).pack(pady=5, fill='x')
        
        # Automation settings
        automation_frame = ttk.LabelFrame(settings_frame, text="Automation Settings", padding=10)
        automation_frame.pack(fill='x', padx=10, pady=5)
        
        ttk.Label(automation_frame, text="Default delay between messages (seconds):").pack(anchor='w')
        ttk.Spinbox(automation_frame, from_=30, to=300, textvariable=self.default_delay_var).pack(pady=5, fill='x')
        
        ttk.Label(automation_frame, text="Maximum messages per session:").pack(anchor='w', pady=(10,0))
        ttk.Spinbox(automation_frame, from_=10, to=200, textvariable=self.max_messages_var).pack(pady=5, fill='x')
        
        # Data settings
        data_frame = ttk.LabelFrame(settings_frame, text="Data Management", padding=10)
        data_frame.pack(fill='x', padx=10, pady=5)
        
        ttk.Button(data_frame, text="🔄 Backup Data", command=self.backup_data).pack(pady=5, fill='x')
        ttk.Button(data_frame, text="📥 Restore Data", command=self.restore_data).pack(pady=5, fill='x')
        ttk.Button(data_frame, text="🗑️ Reset All Data", command=self.reset_data).pack(pady=5, fill='x')
        
        # Save settings button
        ttk.Button(settings_frame, text="💾 Save Settings", 
                     command=self.save_settings, style='Custom.TButton').pack(pady=20)
    
    def create_status_bar(self):
        """Create the status bar"""
        self.status_bar = ttk.Frame(self.root)
        self.status_bar.pack(side='bottom', fill='x')
        
        self.status_label = ttk.Label(self.status_bar, text="Ready to engage with your community! 🚀")
        self.status_label.pack(side='left', padx=10, pady=5)
        
        # Connection status
        self.connection_label = ttk.Label(self.status_bar, text="WhatsApp: Disconnected ❌")
        self.connection_label.pack(side='right', padx=10, pady=5)
    
    # --- Event Handlers / Callbacks ---
    def import_contacts_csv(self):
        file_path = filedialog.askopenfilename(
            title="Select CSV file",
            filetypes=[("CSV files", "*.csv"), ("All files", "*.*")]
        )
        if file_path:
            try:
                with open(file_path, 'r', newline='', encoding='utf-8') as file:
                    reader = csv.DictReader(file)
                    for row in reader:
                        # Basic validation for essential keys, add more as needed
                        if 'Name' in row and 'Phone' in row:
                            self.contacts_data.append(row)
                        else:
                            messagebox.showwarning("CSV Format Warning", 
                                "Skipped a row in CSV due to missing 'Name' or 'Phone' column.")
                self.refresh_contacts_display()
                self.update_status(f"Contacts imported successfully! Added {len(self.contacts_data)} contacts.")
                messagebox.showinfo("Success", f"Imported {len(self.contacts_data)} contacts from CSV")
            except Exception as e:
                messagebox.showerror("Error", f"Failed to import CSV: {str(e)}")
    
    def import_google_sheets(self):
        messagebox.showinfo("Google Sheets", "Google Sheets integration will be implemented in the next version!")
    
    def add_contact_manual(self):
        self.open_contact_dialog()
    
    def open_contact_dialog(self, contact=None):
        dialog = tk.Toplevel(self.root)
        dialog.title("Add/Edit Contact")
        dialog.geometry("400x300")
        dialog.transient(self.root)
        dialog.grab_set()
        
        # Contact form
        ttk.Label(dialog, text="Name:").pack(anchor='w', padx=10, pady=5)
        name_var = tk.StringVar(value=contact.get('Name', '') if contact else '')
        ttk.Entry(dialog, textvariable=name_var).pack(fill='x', padx=10, pady=5)
        
        ttk.Label(dialog, text="Phone:").pack(anchor='w', padx=10, pady=5)
        phone_var = tk.StringVar(value=contact.get('Phone', '') if contact else '')
        ttk.Entry(dialog, textvariable=phone_var).pack(fill='x', padx=10, pady=5)
        
        ttk.Label(dialog, text="Labels (comma-separated):").pack(anchor='w', padx=10, pady=5)
        labels_var = tk.StringVar(value=contact.get('Labels', '') if contact else '')
        ttk.Entry(dialog, textvariable=labels_var).pack(fill='x', padx=10, pady=5)
        
        def save_contact():
            # Basic validation
            if not name_var.get().strip() or not phone_var.get().strip():
                messagebox.showwarning("Input Error", "Name and Phone cannot be empty.")
                return

            new_contact = {
                'Name': name_var.get().strip(),
                'Phone': phone_var.get().strip(),
                'Labels': labels_var.get().strip(),
                'Last Contact': contact.get('Last Contact', 'Never') if contact else 'Never', # Preserve last contact or set new
                'Status': contact.get('Status', 'Active') if contact else 'Active' # Preserve status or set new
            }
            if contact:
                # Edit existing
                index = self.contacts_data.index(contact)
                self.contacts_data[index] = new_contact
            else:
                # Add new, check for duplicates (by phone number for simplicity)
                if any(c['Phone'] == new_contact['Phone'] for c in self.contacts_data):
                    messagebox.showwarning("Duplicate Contact", "A contact with this phone number already exists.")
                    return
                self.contacts_data.append(new_contact)
            
            self.refresh_contacts_display()
            self.save_data() # Save data immediately after adding/editing a contact
            dialog.destroy()
        
        ttk.Button(dialog, text="Save", command=save_contact).pack(pady=20)
    
    def edit_contact(self):
        selection = self.contacts_tree.selection()
        if selection:
            # Get the actual dictionary object from self.contacts_data
            # This is more robust than relying solely on treeview values for editing
            selected_item_values = self.contacts_tree.item(selection[0])['values']
            contact_name = selected_item_values[0]
            contact_phone = selected_item_values[1] # Assuming phone is a more unique identifier

            # Find the actual contact dictionary in your data list
            contact_to_edit = next((c for c in self.contacts_data if c.get('Name') == contact_name and c.get('Phone') == contact_phone), None)

            if contact_to_edit:
                self.open_contact_dialog(contact_to_edit)
            else:
                messagebox.showwarning("Error", "Selected contact not found in data.")
        else:
            messagebox.showwarning("Selection Error", "Please select a contact to edit.")

    def delete_contact(self):
        selection = self.contacts_tree.selection()
        if selection:
            selected_item_values = self.contacts_tree.item(selection[0])['values']
            contact_name = selected_item_values[0]
            contact_phone = selected_item_values[1] # Use phone for more unique identification

            if messagebox.askyesno("Confirm Delete", f"Are you sure you want to delete contact '{contact_name}'?"):
                # Filter out the contact to delete based on name AND phone for uniqueness
                self.contacts_data = [c for c in self.contacts_data if not (c.get('Name') == contact_name and c.get('Phone') == contact_phone)]
                self.refresh_contacts_display()
                self.save_data() # Save data immediately after deleting
                self.update_status(f"Contact '{contact_name}' deleted.")
        else:
            messagebox.showwarning("Selection Error", "Please select a contact to delete.")

    def manage_labels(self):
        messagebox.showinfo("Labels", "Label management feature coming soon!")
    
    def load_template(self, event=None):
        templates = {
            'Welcome Message': "Hi {name}! 👋🏼 Welcome to the RootHub Community! I'm Hannah, your community manager. I'm here to support you on your {track} learning journey. Feel free to reach out if you have any questions!",
            'Check-in Message': "Hi {name}! 👋🏼 Just checking in from the RootHub Community. How's your {track} learning journey going so far? Any challenges I can help you with?",
            'Course Reminder': "Hey {name}! 📚 Don't forget about today's {track} session. Looking forward to seeing your progress!",
            'Follow-up': "Hi {name}! 🤔 I noticed you haven't been active lately in our {track} community. Everything okay? I'm here if you need any support!",
            'Custom': "" # Allow custom template to clear the field
        }
        
        template = templates.get(self.template_var.get(), '')
        self.message_text.delete(1.0, tk.END)
        self.message_text.insert(1.0, template)
    
    def insert_placeholder(self, placeholder):
        self.message_text.insert(tk.INSERT, placeholder)
    
    def preview_recipients(self):
        label_filter = self.labels_var.get().strip()
        if not label_filter:
            messagebox.showwarning("Warning", "Please select a label filter first.")
            return
        
        recipients = [c for c in self.contacts_data if label_filter in c.get('Labels', '').split(',')] # Split labels by comma
        
        preview_window = tk.Toplevel(self.root)
        preview_window.title(f"Recipients for '{label_filter}' label")
        preview_window.geometry("400x300")
        preview_window.transient(self.root)
        preview_window.grab_set() # Make it modal

        listbox_frame = ttk.Frame(preview_window)
        listbox_frame.pack(fill='both', expand=True, padx=10, pady=10)

        listbox = tk.Listbox(listbox_frame)
        listbox.pack(side='left', fill='both', expand=True)

        scrollbar = ttk.Scrollbar(listbox_frame, orient="vertical", command=listbox.yview)
        scrollbar.pack(side='right', fill='y')
        listbox.config(yscrollcommand=scrollbar.set)
        
        if recipients:
            for contact in recipients:
                listbox.insert(tk.END, f"{contact.get('Name', 'N/A')} - {contact.get('Phone', 'N/A')}")
        else:
            listbox.insert(tk.END, "No recipients found for this label.")
        
        ttk.Label(preview_window, text=f"Total recipients: {len(recipients)}").pack(pady=5)
        ttk.Button(preview_window, text="Close", command=preview_window.destroy).pack(pady=5)
    
    def send_dm_now(self):
        message_content = self.message_text.get(1.0, tk.END).strip()
        label_filter = self.labels_var.get().strip()

        if not message_content:
            messagebox.showwarning("Warning", "Please enter a message.")
            return
        if not label_filter:
            messagebox.showwarning("Warning", "Please select a label filter for recipients.")
            return

        recipients = [c for c in self.contacts_data if label_filter in c.get('Labels', '').split(',')]

        if not recipients:
            messagebox.showwarning("No Recipients", "No contacts found with the selected label for DM automation.")
            return

        if not messagebox.askyesno("Confirm Send", f"You are about to send a DM to {len(recipients)} contacts. Continue?"):
            return

        messagebox.showinfo("Send DM", "DM automation started! Check the logs tab for progress. This process will run in the background.")
        self.update_status("Sending DMs... This may take a while")
        
        # --- Placeholder for actual automation logic ---
        # In a real scenario, you'd start a new thread here to run the Selenium automation
        # so the UI doesn't freeze.
        # Example:
        # from threading import Thread
        # automation_thread = Thread(target=self.run_dm_automation_in_background, args=(recipients, message_content, int(self.delay_var.get())))
        # automation_thread.daemon = True # Allows thread to exit when main program exits
        # automation_thread.start()
        
        # Simulate sending for UI demonstration
        for i, contact in enumerate(recipients):
            # Simulate personalization
            personalized_message = message_content.replace('{name}', contact.get('Name', 'Learner')).replace('{track}', contact.get('Labels', 'track').split(',')[0].strip())
            
            log_entry = {
                'Timestamp': datetime.now().strftime('%Y-%m-%d %H:%M:%S'),
                'Type': 'DM',
                'Recipient': f"{contact.get('Name', 'Unknown')} ({contact.get('Phone', 'N/A')})",
                'Message': personalized_message,
                'Status': 'Simulated Sent' # Will be 'Sent' or 'Failed' in real automation
            }
            self.message_log.append(log_entry)
            self.refresh_log_display()
            self.update_status(f"Simulating DM to {contact.get('Name')}...")
            self.root.update_idletasks() # Force UI update
            # time.sleep(1) # Simulate delay in UI for demo; actual delay in automation thread

        self.update_status(f"Simulated sending DMs to {len(recipients)} contacts. Check logs.")
        self.save_data() # Save data after simulation
    
    def schedule_dm(self):
        messagebox.showinfo("Schedule DM", "DM scheduling feature will be implemented!")
    
    def schedule_group_message(self):
        group_name = self.group_var.get().strip()
        message_content = self.group_message_text.get(1.0, tk.END).strip()
        schedule_date_str = self.schedule_date.get().strip()
        schedule_time_str = self.schedule_time.get().strip()
        recurring = self.recurring_var.get()
        frequency = self.frequency_var.get().strip() if recurring else None

        if not group_name or not message_content:
            messagebox.showwarning("Warning", "Please select a group and enter a message.")
            return
        
        try:
            # Basic date/time validation
            scheduled_datetime_str = f"{schedule_date_str} {schedule_time_str}"
            scheduled_dt = datetime.strptime(scheduled_datetime_str, '%Y-%m-%d %H:%M')
            if scheduled_dt < datetime.now():
                if not messagebox.askyesno("Past Time", "The scheduled time is in the past. Do you want to schedule it for the next occurrence (e.g., tomorrow at the same time)?"):
                    return
                # Adjust to next occurrence, e.g., tomorrow
                scheduled_dt = scheduled_dt + timedelta(days=1)
                self.schedule_date.set(scheduled_dt.strftime("%Y-%m-%d"))
                scheduled_datetime_str = scheduled_dt.strftime('%Y-%m-%d %H:%M:%S') # Update for display

        except ValueError:
            messagebox.showerror("Invalid Date/Time", "Please enter a valid date (YYYY-MM-DD) and time (HH:MM).")
            return
        
        if recurring and not frequency:
            messagebox.showwarning("Warning", "Please select a frequency for recurring messages.")
            return

        scheduled_msg = {
            'group': group_name,
            'message': message_content,
            'date_time': scheduled_datetime_str, # Store combined for easier sorting/processing
            'recurring': recurring,
            'frequency': frequency
        }
        
        self.scheduled_messages.append(scheduled_msg)
        self.save_data() # Save scheduled message immediately
        self.refresh_all_displays() # Update the scheduled messages count
        messagebox.showinfo("Success", "Message scheduled successfully!")
        self.update_status(f"Message scheduled for {scheduled_msg['group']} at {scheduled_msg['date_time']}")
        
    def export_log(self):
        file_path = filedialog.asksaveasfilename(
            title="Export log",
            defaultextension=".csv",
            filetypes=[("CSV files", "*.csv"), ("All files", "*.*")]
        )
        if file_path:
            try:
                # Ensure all log entries have all headers, providing empty string if missing
                # This prevents DictWriter from failing if a key is absent in some log entries
                fieldnames = ['Timestamp', 'Type', 'Recipient', 'Message', 'Status']
                processed_log = []
                for entry in self.message_log:
                    processed_entry = {k: entry.get(k, '') for k in fieldnames}
                    processed_log.append(processed_entry)

                with open(file_path, 'w', newline='', encoding='utf-8') as file:
                    writer = csv.DictWriter(file, fieldnames=fieldnames)
                    writer.writeheader()
                    writer.writerows(processed_log)
                messagebox.showinfo("Success", "Log exported successfully!")
                self.update_status(f"Log exported to {file_path}")
            except Exception as e:
                messagebox.showerror("Error", f"Failed to export log: {str(e)}")
    
    def clear_log(self):
        if messagebox.askyesno("Confirm", "Clear all log entries? This action cannot be undone."):
            self.message_log.clear()
            self.refresh_log_display()
            self.save_data() # Save empty log
            self.update_status("Message log cleared.")
    
    def backup_data(self):
        data = {
            'contacts': self.contacts_data,
            'scheduled_messages': self.scheduled_messages,
            'message_log': self.message_log
        }
        
        file_path = filedialog.asksaveasfilename(
            title="Backup data",
            defaultextension=".json",
            filetypes=[("JSON files", "*.json"), ("All files", "*.*")]
        )
        
        if file_path:
            try:
                with open(file_path, 'w', encoding='utf-8') as file:
                    json.dump(data, file, indent=2)
                messagebox.showinfo("Success", "Data backed up successfully!")
                self.update_status(f"Data backed up to {file_path}")
            except Exception as e:
                messagebox.showerror("Error", f"Failed to backup data: {str(e)}")
    
    def restore_data(self):
        file_path = filedialog.askopenfilename(
            title="Restore data",
            filetypes=[("JSON files", "*.json"), ("All files", "*.*")]
        )
        
        if file_path:
            if not messagebox.askyesno("Confirm Restore", "Restoring data will OVERWRITE all current data. Are you sure?"):
                return

            try:
                with open(file_path, 'r', encoding='utf-8') as file:
                    data = json.load(file)
                
                self.contacts_data = data.get('contacts', [])
                self.scheduled_messages = data.get('scheduled_messages', [])
                self.message_log = data.get('message_log', [])
                
                self.refresh_all_displays()
                self.save_data() # Save the restored data immediately
                messagebox.showinfo("Success", "Data restored successfully!")
                self.update_status(f"Data restored from {file_path}")
            except json.JSONDecodeError:
                messagebox.showerror("Error", "Selected file is not a valid JSON backup file.")
            except Exception as e:
                messagebox.showerror("Error", f"Failed to restore data: {str(e)}")
    

