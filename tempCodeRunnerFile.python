import tkinter as tk
from tkinter import ttk, messagebox, filedialog
from datetime import datetime, timedelta # timedelta is not used in current code, can be removed
import json
import csv
import os
from pathlib import Path # Not explicitly used for file ops, but good for path handling

class WhatsAppEngagementUI:
    def __init__(self, root):
        self.root = root
        self.root.title("WATRHC WhatsApp Engagement Assistant")
        self.root.geometry("1000x700")
        self.root.configure(bg='#f0f0f0')

        # --- Data Storage ---
        self.contacts_data = []
        self.scheduled_messages = []
        self.message_log = []

        # --- Tkinter Variables for UI State (Initialize these BEFORE load_data) ---
        # Settings Tab Variables
        self.browser_var = tk.StringVar(value="Chrome")
        self.wait_time_var = tk.StringVar(value="10")
        self.default_delay_var = tk.StringVar(value="45")
        self.max_messages_var = tk.StringVar(value="50")
        
        # DM Automation Tab Variables
        self.template_var = tk.StringVar()
        self.labels_var = tk.StringVar()
        self.delay_var = tk.StringVar(value="45") # Default value for DM delay
        
        # Group Scheduler Tab Variables
        self.group_var = tk.StringVar()
        self.group_msg_type = tk.StringVar()
        self.schedule_date = tk.StringVar(value=datetime.now().strftime("%Y-%m-%d"))
        self.schedule_time = tk.StringVar(value="09:00")
        self.recurring_var = tk.BooleanVar()
        self.frequency_var = tk.StringVar()

        # --- Setup UI Components ---
        self.setup_styles()
        self.create_header()
        self.create_notebook()
        self.create_status_bar()

        # --- Load Data and Refresh Displays ---
        self.load_data() # Now loads into the correctly initialized Tkinter variables
        self.refresh_all_displays() # Refresh displays after data is loaded

    # --- Data Management Methods ---
    def reset_data(self):
        if messagebox.askyesno("Confirm Reset", "This will delete all contacts, scheduled messages, and logs. Continue?"):
            self.contacts_data.clear()
            self.scheduled_messages.clear()
            self.message_log.clear()
            self.refresh_all_displays()
            self.update_status("All data has been reset")
            messagebox.showinfo("Success", "All data has been reset successfully!")
    
    def save_settings(self):
        settings = {
            'browser': self.browser_var.get(),
            'wait_time': self.wait_time_var.get(),
            'default_delay': self.default_delay_var.get(),
            'max_messages': self.max_messages_var.get()
        }
        
        try:
            with open('settings.json', 'w') as file:
                json.dump(settings, file, indent=2)
            messagebox.showinfo("Success", "Settings saved successfully!")
            self.update_status("Settings saved")
        except Exception as e:
            messagebox.showerror("Error", f"Failed to save settings: {str(e)}")
    
    def load_data(self):
        """Load existing data from files"""
        # Load contacts
        if os.path.exists('contacts.json'):
            try:
                with open('contacts.json', 'r', encoding='utf-8') as file:
                    self.contacts_data = json.load(file)
            except json.JSONDecodeError:
                messagebox.showerror("Error", "contacts.json is corrupted or empty. Starting contacts fresh.")
                self.contacts_data = []
            except Exception as e:
                messagebox.showerror("Error", f"Failed to load contacts.json: {str(e)}. Starting contacts fresh.")
                self.contacts_data = []
        
        # Load scheduled messages
        if os.path.exists('scheduled_messages.json'):
            try:
                with open('scheduled_messages.json', 'r', encoding='utf-8') as file:
                    self.scheduled_messages = json.load(file)
            except json.JSONDecodeError:
                messagebox.showerror("Error", "scheduled_messages.json is corrupted or empty. Starting scheduled messages fresh.")
                self.scheduled_messages = []
            except Exception as e:
                messagebox.showerror("Error", f"Failed to load scheduled_messages.json: {str(e)}. Starting scheduled messages fresh.")
                self.scheduled_messages = []

        # Load message log
        if os.path.exists('message_log.json'):
            try:
                with open('message_log.json', 'r', encoding='utf-8') as file:
                    self.message_log = json.load(file)
            except json.JSONDecodeError:
                messagebox.showerror("Error", "message_log.json is corrupted or empty. Starting log fresh.")
                self.message_log = []
            except Exception as e:
                messagebox.showerror("Error", f"Failed to load message_log.json: {str(e)}. Starting log fresh.")
                self.message_log = []
                
        # Load settings
        if os.path.exists('settings.json'):
            try:
                with open('settings.json', 'r') as file:
                    settings = json.load(file)
                    self.browser_var.set(settings.get('browser', 'Chrome'))
                    self.wait_time_var.set(settings.get('wait_time', '10'))
                    self.default_delay_var.set(settings.get('default_delay', '45'))
                    self.max_messages_var.set(settings.get('max_messages', '50'))
            except json.JSONDecodeError:
                messagebox.showerror("Error", "settings.json is corrupted or empty. Using default settings.")
            except Exception as e:
                messagebox.showerror("Error", f"Failed to load settings.json: {str(e)}. Using default settings.")
    
    def save_data(self):
        """Save data to files"""
        try:
            with open('contacts.json', 'w', encoding='utf-8') as file:
                json.dump(self.contacts_data, file, indent=2)
            with open('scheduled_messages.json', 'w', encoding='utf-8') as file:
                json.dump(self.scheduled_messages, file, indent=2)
            with open('message_log.json', 'w', encoding='utf-8') as file:
                json.dump(self.message_log, file, indent=2)
            self.update_status("All data saved.")
        except Exception as e:
            messagebox.showerror("Error", f"Failed to save data: {str(e)}")

    def refresh_contacts_display(self):
        """Refresh the contacts treeview"""
        for item in self.contacts_tree.get_children():
            self.contacts_tree.delete(item)
        
        for contact in self.contacts_data:
            self.contacts_tree.insert('', 'end', values=(
                contact.get('Name', ''),
                contact.get('Phone', ''),
                contact.get('Labels', ''),
                contact.get('Last Contact', 'Never'),
                contact.get('Status', 'Active')
            ))
        
        # Update stats
        self.total_contacts_label.config(text=f"Total Contacts: {len(self.contacts_data)}")
    
    def refresh_log_display(self):
        """Refresh the log treeview"""
        for item in self.log_tree.get_children():
            self.log_tree.delete(item)
        
        for log_entry in self.message_log:
            self.log_tree.insert('', 'end', values=(
                log_entry.get('Timestamp', ''),
                log_entry.get('Type', ''),
                log_entry.get('Recipient', ''),
                log_entry.get('Message', '')[:50] + '...' if len(log_entry.get('Message', '')) > 50 else log_entry.get('Message', ''),
                log_entry.get('Status', '')
            ))
    
    def refresh_all_displays(self):
        """Refresh all data displays"""
        self.refresh_contacts_display()
        self.refresh_log_display()
        
        # Update statistics
        today_messages = len([log for log in self.message_log 
                               if log.get('Timestamp', '').startswith(datetime.now().strftime('%Y-%m-%d'))])
        self.messages_sent_label.config(text=f"Messages Sent Today: {today_messages}")
        self.scheduled_messages_label.config(text=f"Scheduled Messages: {len(self.scheduled_messages)}")
    
    def update_status(self, message):
        """Update the status bar"""
        self.status_label.config(text=message)
        self.root.after(5000, lambda: self.status_label.config(text="Ready to engage with your community! 🚀"))
    
    def on_closing(self):
        """Handle application closing"""
        self.save_data()
        self.root.destroy()

    # --- UI Layout Methods ---
    def setup_styles(self):
        """Configure custom styles for the application"""
        style = ttk.Style()
        
        # Configure main theme
        style.theme_use('clam')
        
        # Custom colors matching WhatsApp's theme
        style.configure('Header.TFrame', background='#075e54')
        style.configure('Header.TLabel', background='#075e54', foreground='white', 
                        font=('Arial', 16, 'bold'))
        style.configure('SubHeader.TLabel', font=('Arial', 12, 'bold'))
        style.configure('Custom.TButton', padding=(10, 5))
        
    def create_header(self):
        """Create the application header"""
        header_frame = ttk.Frame(self.root, style='Header.TFrame')
        header_frame.pack(fill='x', pady=(0, 10))
        
        title_label = ttk.Label(header_frame, text="🚀 WATRHC WhatsApp Engagement Assistant", 
                                 style='Header.TLabel')
        title_label.pack(pady=10)
        
        subtitle_label = ttk.Label(header_frame, 
                                     text="Automate community engagement for 530+ learners across 11 tracks",
                                     style='Header.TLabel', font=('Arial', 10))
        subtitle_label.pack()
    
    def create_notebook(self):
        """Create the main tabbed interface"""
        self.notebook = ttk.Notebook(self.root)
        self.notebook.pack(fill='both', expand=True, padx=10, pady=5)
        
        # Create tabs
        self.create_contacts_tab()
        self.create_dm_automation_tab()
        self.create_group_scheduler_tab()
        self.create_logs_tab()
        self.create_settings_tab()
    
    def create_contacts_tab(self):
        """Create the contacts management tab"""
        contacts_frame = ttk.Frame(self.notebook)
        self.notebook.add(contacts_frame, text="📱 Contacts & Labels")
        
        # Import section
        import_frame = ttk.LabelFrame(contacts_frame, text="Import Contacts", padding=10)
        import_frame.pack(fill='x', padx=10, pady=5)
        
        ttk.Button(import_frame, text="📄 Import from CSV", 
                     command=self.import_contacts_csv, style='Custom.TButton').pack(side='left', padx=5)
        ttk.Button(import_frame, text="📊 Import from Google Sheets", 
                     command=self.import_google_sheets, style='Custom.TButton').pack(side='left', padx=5)
        ttk.Button(import_frame, text="➕ Add Contact Manually", 
                     command=self.add_contact_manual, style='Custom.TButton').pack(side='left', padx=5)
        
        # Contacts display
        contacts_display_frame = ttk.LabelFrame(contacts_frame, text="Contacts Overview", padding=10)
        contacts_display_frame.pack(fill='both', expand=True, padx=10, pady=5)
        
        # Treeview for contacts
        columns = ('Name', 'Phone', 'Labels', 'Last Contact', 'Status')
        self.contacts_tree = ttk.Treeview(contacts_display_frame, columns=columns, show='headings', height=15)
        
        for col in columns:
            self.contacts_tree.heading(col, text=col)
            self.contacts_tree.column(col, width=150)
        
        # Scrollbars
        v_scrollbar = ttk.Scrollbar(contacts_display_frame, orient='vertical', command=self.contacts_tree.yview)
        h_scrollbar = ttk.Scrollbar(contacts_display_frame, orient='horizontal', command=self.contacts_tree.xview)
        self.contacts_tree.configure(yscrollcommand=v_scrollbar.set, xscrollcommand=h_scrollbar.set)
        
        self.contacts_tree.pack(side='left', fill='both', expand=True)
        v_scrollbar.pack(side='right', fill='y')
        h_scrollbar.pack(side='bottom', fill='x')
        
        # Contact actions
        actions_frame = ttk.Frame(contacts_display_frame)
        actions_frame.pack(side='right', fill='y', padx=10)
        
        ttk.Button(actions_frame, text="✏️ Edit Contact", command=self.edit_contact).pack(pady=5, fill='x')
        ttk.Button(actions_frame, text="🏷️ Manage Labels", command=self.manage_labels).pack(pady=5, fill='x')
        ttk.Button(actions_frame, text="🗑️ Delete Contact", command=self.delete_contact).pack(pady=5, fill='x')
    
    def create_dm_automation_tab(self):
        """Create the DM automation tab"""
        dm_frame = ttk.Frame(self.notebook)
        self.notebook.add(dm_frame, text="💬 DM Automation")
        
        # Message template section
        template_frame = ttk.LabelFrame(dm_frame, text="Message Templates", padding=10)
        template_frame.pack(fill='x', padx=10, pady=5)
        
        ttk.Label(template_frame, text="Select Template:").pack(anchor='w')
        template_combo = ttk.Combobox(template_frame, textvariable=self.template_var, width=50)
        template_combo['values'] = ('Welcome Message', 'Check-in Message', 'Course Reminder', 'Follow-up', 'Custom')
        template_combo.pack(pady=5, fill='x')
        template_combo.bind('<<ComboboxSelected>>', self.load_template)
        
        # Message content
        ttk.Label(template_frame, text="Message Content:").pack(anchor='w', pady=(10,0))
        self.message_text = tk.Text(template_frame, height=6, wrap='word')
        self.message_text.pack(fill='x', pady=5)
        
        # Personalization options
        personalization_frame = ttk.Frame(template_frame)
        personalization_frame.pack(fill='x', pady=5)
        
        ttk.Label(personalization_frame, text="Personalization:").pack(side='left')
        ttk.Button(personalization_frame, text="Add {name}", 
                     command=lambda: self.insert_placeholder('{name}')).pack(side='left', padx=5)
        ttk.Button(personalization_frame, text="Add {track}", 
                     command=lambda: self.insert_placeholder('{track}')).pack(side='left', padx=5)
        
        # Target selection
        target_frame = ttk.LabelFrame(dm_frame, text="Target Audience", padding=10)
        target_frame.pack(fill='x', padx=10, pady=5)
        
        ttk.Label(target_frame, text="Send to contacts with labels:").pack(anchor='w')
        labels_combo = ttk.Combobox(target_frame, textvariable=self.labels_var, width=50)
        labels_combo['values'] = ('WATRHC', 'UI/UX Learner', 'Python Learner', 'Data Science', 'Follow-up', 'No Response')
        labels_combo.pack(pady=5, fill='x')
        
        # Send options
        send_frame = ttk.LabelFrame(dm_frame, text="Send Options", padding=10)
        send_frame.pack(fill='x', padx=10, pady=5)
        
        options_frame = ttk.Frame(send_frame)
        options_frame.pack(fill='x')
        
        ttk.Label(options_frame, text="Delay between messages (seconds):").pack(side='left')
        delay_spinbox = ttk.Spinbox(options_frame, from_=30, to=300, textvariable=self.delay_var, width=10)
        delay_spinbox.pack(side='left', padx=10)
        
        # Send buttons
        button_frame = ttk.Frame(send_frame)
        button_frame.pack(fill='x', pady=10)
        
        ttk.Button(button_frame, text="📋 Preview Recipients", 
                     command=self.preview_recipients, style='Custom.TButton').pack(side='left', padx=5)
        ttk.Button(button_frame, text="📤 Send Now", 
                     command=self.send_dm_now, style='Custom.TButton').pack(side='left', padx=5)
        ttk.Button(button_frame, text="⏰ Schedule for Later", 
                     command=self.schedule_dm, style='Custom.TButton').pack(side='left', padx=5)
    
    def create_group_scheduler_tab(self):
        """Create the group message scheduler tab"""
        scheduler_frame = ttk.Frame(self.notebook)
        self.notebook.add(scheduler_frame, text="👥 Group Scheduler")
        
        # Group selection
        group_frame = ttk.LabelFrame(scheduler_frame, text="Select Group", padding=10)
        group_frame.pack(fill='x', padx=10, pady=5)
        
        ttk.Label(group_frame, text="WhatsApp Group:").pack(anchor='w')
        group_combo = ttk.Combobox(group_frame, textvariable=self.group_var, width=50)
        group_combo['values'] = ('Python Class A', 'Python Class B', 'UI/UX Design Track', 'Data Science Track', 
                                 'Digital Marketing', 'General Announcements')
        group_combo.pack(pady=5, fill='x')
        
        # Message content for groups
        message_frame = ttk.LabelFrame(scheduler_frame, text="Message Content", padding=10)
        message_frame.pack(fill='both', expand=True, padx=10, pady=5)
        
        ttk.Label(message_frame, text="Message Type:").pack(anchor='w')
        type_combo = ttk.Combobox(message_frame, textvariable=self.group_msg_type, width=50)
        type_combo['values'] = ('Daily Tip', 'Weekly Quiz', 'Motivational Message', 'Course Update', 'Custom')
        type_combo.pack(pady=5, fill='x')
        
        ttk.Label(message_frame, text="Message:").pack(anchor='w', pady=(10,0))
        self.group_message_text = tk.Text(message_frame, height=8, wrap='word')
        self.group_message_text.pack(fill='both', expand=True, pady=5)
        
        # Scheduling options
        schedule_frame = ttk.LabelFrame(scheduler_frame, text="Schedule Options", padding=10)
        schedule_frame.pack(fill='x', padx=10, pady=5)
        
        schedule_grid = ttk.Frame(schedule_frame)
        schedule_grid.pack(fill='x')
        
        ttk.Label(schedule_grid, text="Date:").grid(row=0, column=0, sticky='w', padx=5)
        ttk.Entry(schedule_grid, textvariable=self.schedule_date).grid(row=0, column=1, padx=5)
        
        ttk.Label(schedule_grid, text="Time:").grid(row=0, column=2, sticky='w', padx=5)
        ttk.Entry(schedule_grid, textvariable=self.schedule_time).grid(row=0, column=3, padx=5)
        
        # Recurring options
        recurring_frame = ttk.Frame(schedule_frame)
        recurring_frame.pack(fill='x', pady=10)
        
        ttk.Checkbutton(recurring_frame, text="Recurring message", 
