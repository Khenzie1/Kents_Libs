# --- Main Application Entry Point ---
def main():
    root = tk.Tk()
    app = WhatsAppEngagementUI(root)
    
    # Initialize the automation engine and pass UI reference
    # You'll likely want a button in the UI to trigger this connection
    automation_engine = WhatsAppAutomationEngine(app) 
    
    # Example: A button to connect to WhatsApp in the UI (e.g., in Settings tab)
    # app.connect_button = ttk.Button(app.whatsapp_frame, text="Connect to WhatsApp", command=automation_engine.connect_whatsapp)
    # app.connect_button.pack(pady=10)

    # Handle window closing
    root.protocol("WM_DELETE_WINDOW", app.on_closing)
    
    # Center the window (must be called after mainloop, or after first .update_idletasks())
    root.update_idletasks() # Ensure geometry info is up-to-date
    x = (root.winfo_screenwidth() - root.winfo_width()) // 2
    y = (root.winfo_screenheight() - root.winfo_height()) // 2
    root.geometry(f"+{x}+{y}")
    
    # Start the application
    root.mainloop()

if __name__ == "__main__":
    main()